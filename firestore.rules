rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /projects/{projectId}
// Fields:
//   - slug: string (optional)
//   - title: string
//   - titleLower: string
//   - description: string
//   - level: string
//   - category: string
//   - techStack: list of strings
//   - imageUrl: string
//   - screenshots: list of strings
//   - likes: number
//   - comments: list of comment maps
//   - updates: list of update maps
//   - status: string ('idea' | 'in-progress' | 'beta' | 'launched')
//   - authorUid: string (immutable creator UID)
//   - approvalStatus: string ('pending' | 'approved' | 'rejected')
//   - xpMilestonesAwarded: list of numbers (IMMUTABLE by clients)
//   - isSuspended: bool (optional)
//   - suspendedBy: string (optional)
//   - suspendedAt: string (optional)
//   - suspensionReason: string (optional)
//   - repoUrl: string (optional)
//   - openToContributions: bool (optional)
//   - contributionAreas: list of strings (optional)
//   - githubMeta: map (optional)
//   - contributorUids: list of strings (optional)
//
// Collection: /votes/{voteId} (document ID format: {userId}_{projectId})
// Fields:
//   - userId: string
//   - projectId: string
//   - createdAt: timestamp
//
// Collection: /writings/{writingId}
// Fields:
//   - title: string
//   - body: string
//   - genre: string ('short-story' | 'poem' | 'essay')
//   - displayName: string
//   - authorPhotoURL: string (optional)
//   - likes: number
//   - comments: list of comment maps
//   - authorUid: string
//   - approvalStatus: string ('pending' | 'approved' | 'rejected')
//   - rejectionReason: string (optional)
//   - isSuspended: bool (optional)
//
// Collection: /litVotes/{voteId} (document ID format: {userId}_{writingId})
// Fields:
//   - userId: string
//   - writingId: string
//   - createdAt: timestamp
//
// Collection: /users/{userId}
// Fields:
//   - uid: string
//   - displayName: string
//   - email: string
//   - photoURL: string (optional)
//   - xp: number (IMMUTABLE by clients)
//   - seasonXp: number (IMMUTABLE by clients)
//   - streakDays: number (IMMUTABLE by clients)
//   - lastLoginDate: string (IMMUTABLE by clients)
//   - commentXpToday: number (IMMUTABLE by clients)
//   - lastCommentXpDate: string (IMMUTABLE by clients)
//   - isAdmin: bool (IMMUTABLE by non-admins)
//   - hasEditedDisplayName: bool
//   - displayNameEditedAt: string (optional)
//   - joinedAt: timestamp or string
//   - goCoins: number (IMMUTABLE by non-admins)
//   - totalGoCoinsEarned: number (IMMUTABLE by non-admins)
//   - verificationStatus: string ('none' | 'pending' | 'verified' | 'rejected')
//   - studentIdCardUrl: string (optional)
//   - verificationRejectionReason: string (optional)
//   - bankDetails: map (optional)
//   - bannerPreset: string (optional)
//   - bannerUrl: string (optional)
//   - bio: string (optional)
//   - department: string (optional)
//   - academicLevel: string (optional)
//   - accentColor: string (optional)
//   - githubProfile: map or null (optional)
//   - githubUsernameLower: string or null (optional)
//   - onboardingCompletedAt: timestamp (IMMUTABLE by clients)
//   - lastRewardedCodingDate: string (IMMUTABLE by clients)
//   - githubSyncedAt: timestamp (IMMUTABLE by clients)
//   - interests: list of strings (optional)
//   - completedQuests: list of strings (IMMUTABLE by clients)
//
// Subcollection: /users/{userId}/notifications/{notifId}
// Fields:
//   - type: string
//   - userId: string
//   - triggerUid: string
//   - triggerDisplayName: string
//   - projectId: string
//   - projectTitle: string
//   - message: string
//   - previewText: string
//   - viewedAt: string or null
//   - createdAt: string
//   - expiresAt: string
//   - link: map (optional)
//
// Subcollection: /users/{userId}/favorites/{projectId}
// Fields:
//   - addedAt: timestamp
//
// Collection: /examPapers/{paperId}
// Fields:
//   - courseCode: string
//   - courseTitle: string
//   - level: string
//   - semester: string
//   - imageUrls: list of strings (1 to 6 URLs)
//   - authorUid: string (immutable creator UID)
//   - displayName: string
//   - authorPhotoURL: string or null
//   - slotNumber: number (1 to 5)
//   - status: string ('pending' | 'approved' | 'rejected' | 'not_selected')
//   - rejectionReason: string (optional)
//   - createdAt: timestamp
//   - reviewedAt: string (optional)
//   - reviewedBy: string (optional)
//
// Collection: /courseBounties/{courseCode}
// Fields:
//   - courseCode: string
//   - courseTitle: string
//   - level: string
//   - submissionCount: number (0 to 5)
//   - submittedUserIds: list of strings
//   - isCollected: bool
//   - winnerUid: string (optional)
//   - winnerPaperId: string (optional)
//   - updatedAt: string
//
// Collection: /payouts/{payoutId}
// Fields:
//   - userId: string
//   - displayName: string
//   - coinsPaid: number
//   - nairaAmount: number
//   - bankDetails: map
//   - seasonNumber: number
//   - paidAt: string
//   - paidBy: string
//
// Collection: /xpLedger/{ledgerId}
// Fields:
//   - userId: string
//   - amount: number
//   - reason: string
//   - meta: map (optional)
//   - createdAt: timestamp
//
// Collection: /xpDaily/{dailyId}
// Fields:
//   - userId: string
//   - date: string
//   - total: number
//   - updatedAt: timestamp
//
// Collection: /campaignSubmissions/{submissionId}
// Fields:
//   - campaignId: string ('prayer_book_s1')
//   - authorUid: string (immutable creator UID)
//   - displayName: string
//   - authorPhotoURL: string or null (optional)
//   - teamSize: string ('solo' | 'duo')
//   - partnerUsername: string or null (optional)
//   - partnerUid: string or null (optional)
//   - repoUrl: string
//   - figmaUrl: string
//   - pitchSummary: string
//   - screenshots: list of strings (1 to 5 URLs)
//   - likes: number
//   - votedUserIds: list of strings
//   - status: string ('pending' | 'approved' | 'rejected' | 'winner')
//   - rejectionReason: string (optional)
//   - createdAt: timestamp
//   - reviewedAt: string (optional)
//   - reviewedBy: string (optional)
//
// Collection: /settings/{docId}
// Fields:
//   - title: string
//   - content: string
//   - updatedAt: string
//   - updatedBy: string (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Projects ──

    match /projects/{projectId} {
      allow read: if resource.data.approvalStatus == 'approved' || (
        isSignedIn() && (
          resource.data.authorUid == request.auth.uid ||
          isAdmin()
        )
      );

      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.approvalStatus == 'pending' &&
        request.resource.data.likes == 0 &&
        request.resource.data.comments.size() == 0 &&
        request.resource.data.updates.size() == 0;

      allow update: if isSignedIn() && (
        isAdmin() ||

        // Author editing their own project content (including collaboration settings & GitHub metadata)
        (
          resource.data.authorUid == request.auth.uid &&
          !affectedKeys().hasAny([
            'authorUid',
            'approvalStatus',
            'isSuspended',
            'suspendedBy',
            'suspendedAt',
            'suspensionReason',
            'likes',
            'xpMilestonesAwarded'
          ])
        ) ||

        // Author or admin syncing live GitHub repository metadata & contributors
        (
          (resource.data.authorUid == request.auth.uid || isAdmin()) &&
          affectedKeys().hasOnly(['githubMeta', 'contributorUids']) &&
          request.resource.data.contributorUids is list &&
          request.resource.data.contributorUids.size() <= 50
        ) ||

        // Any signed-in user toggling vote (likes ±1, atomized with vote document)
        (
          affectedKeys().hasOnly(['likes']) &&
          math.abs(request.resource.data.likes - resource.data.likes) == 1 &&
          (
            (request.resource.data.likes > resource.data.likes &&
              !exists(/databases/$(database)/documents/votes/$(request.auth.uid + '_' + projectId)) &&
              existsAfter(/databases/$(database)/documents/votes/$(request.auth.uid + '_' + projectId))) ||
            (request.resource.data.likes < resource.data.likes &&
              exists(/databases/$(database)/documents/votes/$(request.auth.uid + '_' + projectId)) &&
              !existsAfter(/databases/$(database)/documents/votes/$(request.auth.uid + '_' + projectId)))
          )
        ) ||

        // Any signed-in user appending a comment
        (
          affectedKeys().hasOnly(['comments']) &&
          request.resource.data.comments.size() == resource.data.get('comments', []).size() + 1 &&
          request.resource.data.comments[resource.data.get('comments', []).size()].authorUid == request.auth.uid
        )
      );

      allow delete: if isAdmin();
    }

    // ── Votes ──

    match /votes/{voteId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        voteId == request.auth.uid + '_' + request.resource.data.projectId &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow update: if false;
    }

    // ── Writings (Lit Club) ──

    match /writings/{writingId} {
      allow read: if resource.data.approvalStatus == 'approved' || (
        isSignedIn() && (
          resource.data.authorUid == request.auth.uid ||
          isAdmin()
        )
      );

      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.approvalStatus == 'pending' &&
        request.resource.data.likes == 0 &&
        request.resource.data.comments.size() == 0;

      allow update: if isSignedIn() && (
        isAdmin() ||

        // Author editing their own writing
        (
          resource.data.authorUid == request.auth.uid &&
          !affectedKeys().hasAny([
            'authorUid',
            'approvalStatus',
            'isSuspended',
            'suspendedBy',
            'suspendedAt',
            'suspensionReason',
            'likes',
            'rejectionReason'
          ])
        ) ||

        // Any signed-in user toggling vote on writing (likes ±1, atomized with litVotes document)
        (
          affectedKeys().hasOnly(['likes']) &&
          math.abs(request.resource.data.likes - resource.data.likes) == 1 &&
          (
            (request.resource.data.likes > resource.data.likes &&
              !exists(/databases/$(database)/documents/litVotes/$(request.auth.uid + '_' + writingId)) &&
              existsAfter(/databases/$(database)/documents/litVotes/$(request.auth.uid + '_' + writingId))) ||
            (request.resource.data.likes < resource.data.likes &&
              exists(/databases/$(database)/documents/litVotes/$(request.auth.uid + '_' + writingId)) &&
              !existsAfter(/databases/$(database)/documents/litVotes/$(request.auth.uid + '_' + writingId)))
          )
        ) ||

        // Any signed-in user appending a comment to writing
        (
          affectedKeys().hasOnly(['comments']) &&
          request.resource.data.comments.size() == resource.data.get('comments', []).size() + 1 &&
          request.resource.data.comments[resource.data.get('comments', []).size()].authorUid == request.auth.uid
        )
      );

      allow delete: if isAdmin();
    }

    // ── Lit Votes ──

    match /litVotes/{voteId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        voteId == request.auth.uid + '_' + request.resource.data.writingId &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow update: if false;
    }

    // ── Season 1: Exam Question Paper Bounty ──

    match /examPapers/{paperId} {
      // Strictly private: only the submitting student or an admin may read exam paper submissions
      allow read: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.slotNumber is number &&
        request.resource.data.slotNumber >= 1 &&
        request.resource.data.slotNumber <= 5 &&
        request.resource.data.imageUrls is list &&
        request.resource.data.imageUrls.size() >= 1 &&
        request.resource.data.imageUrls.size() <= 6 &&
        request.resource.data.courseCode is string &&
        request.resource.data.courseCode.size() > 0 &&
        request.resource.data.courseCode.size() <= 30;

      allow update, delete: if isAdmin();
    }

    match /courseBounties/{courseCode} {
      // Publicly readable so the 5-Slot Course Tracker works without exposing private exam paper images
      allow read: if true;

      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.courseCode == courseCode &&
          request.resource.data.submissionCount == 1 &&
          request.resource.data.isCollected == false &&
          request.resource.data.submittedUserIds is list &&
          request.resource.data.submittedUserIds.size() == 1 &&
          request.resource.data.submittedUserIds[0] == request.auth.uid
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.get('isCollected', false) == false &&
          request.resource.data.isCollected == false &&
          !affectedKeys().hasAny(['winnerUid', 'winnerPaperId']) &&
          !(request.auth.uid in resource.data.get('submittedUserIds', [])) &&
          request.resource.data.submittedUserIds is list &&
          request.auth.uid in request.resource.data.submittedUserIds &&
          request.resource.data.submittedUserIds.size() == resource.data.get('submittedUserIds', []).size() + 1 &&
          request.resource.data.submissionCount == resource.data.get('submissionCount', 0) + 1 &&
          request.resource.data.submissionCount >= 1 &&
          request.resource.data.submissionCount <= 5
        )
      );

      allow delete: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create, update, delete: if isAdmin();
    }

    // ── XP & Gamification (Server-Authoritative Ledger) ──

    match /xpLedger/{ledgerId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /xpDaily/{dailyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Campaign Submissions (Season 1) ──

    match /campaignSubmissions/{submissionId} {
      allow read: if resource.data.status in ['approved', 'winner'] || (
        isSignedIn() && (
          resource.data.authorUid == request.auth.uid ||
          isAdmin()
        )
      );

      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.likes == 0 &&
        request.resource.data.get('votedUserIds', []) == [] &&
        request.resource.data.teamSize in ['solo', 'duo'] &&
        request.resource.data.screenshots is list &&
        request.resource.data.screenshots.size() >= 1 &&
        request.resource.data.screenshots.size() <= 5 &&
        request.resource.data.repoUrl is string &&
        request.resource.data.repoUrl.size() > 0 &&
        request.resource.data.figmaUrl is string &&
        request.resource.data.figmaUrl.size() > 0 &&
        (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('xp', 0) >= 100
          )
        );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.status in ['approved', 'winner'] &&
          affectedKeys().hasOnly(['likes', 'votedUserIds']) &&
          request.resource.data.votedUserIds is list &&
          math.abs(request.resource.data.likes - resource.data.likes) == 1
        )
      );

      allow delete: if isAdmin();
    }

    // ── Users & Subcollections ──

    match /users/{userId} {
      allow read: if true;

      // New profile creation: must be owner, cannot bootstrap as admin, starts at 0 XP & 0 GoCoins & unverified
      allow create: if isOwner(userId) &&
        request.resource.data.isAdmin == false &&
        request.resource.data.xp == 0 &&
        request.resource.data.seasonXp == 0 &&
        request.resource.data.hasEditedDisplayName == false &&
        request.resource.data.get('goCoins', 0) == 0 &&
        request.resource.data.get('totalGoCoinsEarned', 0) == 0 &&
        request.resource.data.get('verificationStatus', 'none') == 'none' &&
        request.resource.data.get('streakDays', 0) == 0 &&
        request.resource.data.get('lastLoginDate', '') == '' &&
        request.resource.data.get('commentXpToday', 0) == 0 &&
        request.resource.data.get('lastCommentXpDate', '') == '' &&
        request.resource.data.get('githubProfile', null) == null &&
        request.resource.data.get('completedQuests', []) == [] &&
        !('onboardingCompletedAt' in request.resource.data) &&
        !('lastRewardedCodingDate' in request.resource.data) &&
        !('githubSyncedAt' in request.resource.data);

      allow update: if isSignedIn() && (
        isAdmin() ||

        // Owner updating profile
        (
          isOwner(userId) &&
          // Cannot promote to admin, alter joinedAt, self-mint GoCoins, or modify server-authoritative XP, streak, onboarding, GitHub sync, and quests fields
          !affectedKeys().hasAny([
            'isAdmin', 'joinedAt', 'goCoins', 'totalGoCoinsEarned',
            'xp', 'seasonXp', 'streakDays', 'lastLoginDate',
            'commentXpToday', 'lastCommentXpDate',
            'onboardingCompletedAt', 'lastRewardedCodingDate', 'githubSyncedAt',
            'completedQuests'
          ]) &&
          // Cannot self-verify Student ID; can only keep status unchanged or set to 'pending' on ID upload
          (
            request.resource.data.get('verificationStatus', 'none') == resource.data.get('verificationStatus', 'none') ||
            request.resource.data.get('verificationStatus', 'none') == 'pending'
          ) &&
          // Display name edit can only flip once from false to true
          (
            request.resource.data.get('hasEditedDisplayName', false) == resource.data.get('hasEditedDisplayName', false) ||
            (resource.data.get('hasEditedDisplayName', false) == false && request.resource.data.get('hasEditedDisplayName', false) == true)
          ) &&
          // Client can ONLY disconnect GitHub (setting both profile and username to null); cannot write arbitrary profile/username
          (
            !affectedKeys().hasAny(['githubProfile', 'githubUsernameLower']) ||
            (
              request.resource.data.get('githubProfile', null) == null &&
              request.resource.data.get('githubUsernameLower', null) == null
            )
          ) &&
          // Client interests field: must be a list with max 5 items
          (
            !affectedKeys().hasAny(['interests']) ||
            (
              request.resource.data.get('interests', []) is list &&
              request.resource.data.get('interests', []).size() <= 5
            )
          )
        )
      );

      allow delete: if isAdmin();

      // Notifications subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId);

        allow create: if isSignedIn() && (
          request.resource.data.triggerUid == request.auth.uid ||
          isAdmin()
        );

        allow update: if isOwner(userId) &&
          affectedKeys().hasOnly(['viewedAt']);

        allow delete: if isOwner(userId) || isAdmin();
      }

      // Favorites subcollection
      match /favorites/{projectId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ── Settings ──

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
